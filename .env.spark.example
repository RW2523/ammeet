# AmMeeting — DGX Spark deployment env.  cp .env.spark.example .env.spark  and edit.
# Used by: docker compose -f docker-compose.spark.yml --env-file .env.spark up -d --build

# ── Required ──────────────────────────────────────────────────────────────────
# LAN address of the Spark (IP or mDNS name) — baked into the frontend build and
# used for CORS/links. Find it with:  ip -4 addr show | grep inet
SPARK_HOST=192.168.1.50

# Postgres password (compose wires DATABASE_URL for you)
POSTGRES_PASSWORD=change-me-strong

# Long random strings (64+ chars):  openssl rand -hex 48
SECRET_KEY=change-me-64-chars-minimum
TOKEN_ENCRYPTION_KEY=change-me-64-chars-minimum

# Browser origins allowed to call the API. Must include the frontend AND the
# Chrome extension's origin (find the ID at chrome://extensions after loading it).
CORS_ORIGINS=http://192.168.1.50:3000,chrome-extension://YOUR_EXTENSION_ID

# ── AI (fully local via Ollama on the Spark GPU) ─────────────────────────────
# Zero-config default: with LLM_BASE_URL set, every new account gets the local
# GPU model with no setup. The admin can still override in Settings → AI Models.
LLM_PROVIDER=openai
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:14b
EMBEDDING_MODEL=nomic-embed-text
OPENAI_API_KEY=

# ── STT (optional — captions capture needs NO STT) ──────────────────────────
# For local GPU Whisper, start compose with:  --profile stt   and set:
#   STT_PROVIDER=whisper
#   WHISPER_BASE_URL=http://stt:8000/v1
STT_PROVIDER=mock
WHISPER_BASE_URL=https://api.openai.com/v1

# ── Behavior ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_PROVIDER=console
TTS_PROVIDER=none
BOT_PROVIDER=mock
AUTO_JOIN_SCHEDULER_ENABLED=false

# ── Optional integrations (leave empty to disable) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
